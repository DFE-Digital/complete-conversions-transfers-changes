@using Dfe.Complete.Constants
@model Dfe.Complete.Models.ProjectList.ProjectListFilters
@{
    var selectedStatuses = new HashSet<string>(Model.SelectedStatuses ?? [], StringComparer.OrdinalIgnoreCase);
    var selectedProjectOwners = new HashSet<string>(Model.SelectedProjectOwners ?? [], StringComparer.OrdinalIgnoreCase);
    var selectedRegions = new HashSet<string>(Model.SelectedRegions ?? [], StringComparer.OrdinalIgnoreCase);
    var selectedLocalAuthorities = new HashSet<string>(Model.SelectedLocalAuthorities ?? [], StringComparer.OrdinalIgnoreCase);
}

<div class="moj-filter">
    <div class="moj-filter__header">
        <div class="moj-filter__header-title">
            <h2 class="govuk-heading-m">Filter</h2>
        </div>

        <div class="moj-filter__header-action">
        </div>
    </div>

    <div class="moj-filter__content">
        @if (Model.IsVisible)
        {
            <div class="moj-filter__selected">
                <div class="moj-filter__selected-heading">
                    <div class="moj-filter__heading-title">
                        <h2 class="govuk-heading-m">Selected filters</h2>
                    </div>

                    <div class="moj-filter__heading-action">
                        <p>
                            <a class="govuk-link govuk-link--no-visited-state" href="@($"{RouteConstants.SignificantChange}?clear=1")">Clear filters</a>
                        </p>
                    </div>
                </div>

                @foreach (var group in Model.AppliedFilterGroups)
                {
                    <h3 class="govuk-heading-s govuk-!-margin-bottom-0">@group.Heading</h3>

                    <ul class="moj-filter-tags">
                        @foreach (var chip in group.Chips)
                        {
                            <li><a class="moj-filter__tag" href="@chip.RemoveUrl"><span class="govuk-visually-hidden">Remove this filter</span> @chip.Label</a></li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="moj-filter__options">
            <form method="get" action="@RouteConstants.SignificantChange">
                <govuk-button type="submit">Apply filters</govuk-button>

                <div class="govuk-form-group">
                    <label class="govuk-label govuk-label--m govuk-!-margin-top-0" for="projects-filter-keyword">Search for change</label>
                    <div class="govuk-hint" id="projects-filter-keyword-hint">You can search by school name, academy name, trust name, URN and trust UKPRN</div>
                    <input id="projects-filter-keyword" class="govuk-input" name="Keyword" type="text" aria-describedby="projects-filter-keyword-hint" value="@Model.Keyword" />
                </div>

                <div class="govuk-accordion" data-module="govuk-accordion" id="projects-filter-accordion">
                    <div class="govuk-accordion__section">
                        <div class="govuk-accordion__section-header">
                            <h2 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button" id="projects-filter-status-heading">
                                    Status
                                </span>
                            </h2>
                        </div>
                        <section class="govuk-accordion__section-content" aria-labelledby="projects-filter-status-heading" id="projects-filter-status-content">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-visually-hidden" for="statusText">Type to filter statuses</label>
                                <input id="statusText" class="govuk-input" type="text" placeholder="Type to filter statuses..." autocomplete="off" />
                            </div>

                            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                                @foreach (var option in Model.StatusOptions)
                                {
                                    @* TODO - replace this with an extension method, prepare uses status.Stub() *@
                                    var checkboxId = $"status-{option.Value.Replace(" ", "-").ToLowerInvariant()}";
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input"
                                               id="@checkboxId"
                                               name="SelectedStatuses"
                                               type="checkbox"
                                               value="@option.Value"
                                               checked="@(selectedStatuses.Contains(option.Value) ? "checked" : null)" />
                                        <label class="govuk-label govuk-checkboxes__label" for="@checkboxId">@option.Label</label>
                                    </div>
                                }
                                @foreach (var value in selectedStatuses.Except(Model.StatusOptions.Select(o => o.Value), StringComparer.OrdinalIgnoreCase))
                                {
                                    <input type="hidden" name="SelectedStatuses" value="@value" />
                                }
                            </div>
                        </section>
                    </div>
                    <div class="govuk-accordion__section">
                        <div class="govuk-accordion__section-header">
                            <h2 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button" id="projects-filter-project-owner-heading">
                                    Project owner
                                </span>
                            </h2>
                        </div>
                        <section class="govuk-accordion__section-content" aria-labelledby="projects-filter-project-owner-heading" id="projects-filter-project-owner-content">
                            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                                @foreach (var option in Model.ProjectOwnerOptions)
                                {
                                    var checkboxId = $"project-owner-{option.Value}";
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input"
                                               id="@checkboxId"
                                               name="SelectedProjectOwners"
                                               type="checkbox"
                                               value="@option.Value"
                                               checked="@(selectedProjectOwners.Contains(option.Value) ? "checked" : null)" />
                                        <label class="govuk-label govuk-checkboxes__label" for="@checkboxId">@option.Label</label>
                                    </div>
                                }
                                @foreach (var value in selectedProjectOwners.Except(Model.ProjectOwnerOptions.Select(o => o.Value), StringComparer.OrdinalIgnoreCase))
                                {
                                    <input type="hidden" name="SelectedProjectOwners" value="@value" />
                                }
                            </div>
                        </section>
                    </div>

                    <div class="govuk-accordion__section">
                        <div class="govuk-accordion__section-header">
                            <h2 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button" id="projects-filter-region-heading">
                                    Region
                                </span>
                            </h2>
                        </div>
                        <section class="govuk-accordion__section-content" aria-labelledby="projects-filter-region-heading" id="projects-filter-region-content">
                            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                                @foreach (var option in Model.RegionOptions)
                                {
                                    var checkboxId = $"region-{option.Value}";
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input"
                                               id="@checkboxId"
                                               name="SelectedRegions"
                                               type="checkbox"
                                               value="@option.Value"
                                               checked="@(selectedRegions.Contains(option.Value) ? "checked" : null)" />
                                        <label class="govuk-label govuk-checkboxes__label" for="@checkboxId">@option.Label</label>
                                    </div>
                                }
                                @foreach (var value in selectedRegions.Except(Model.RegionOptions.Select(o => o.Value), StringComparer.OrdinalIgnoreCase))
                                {
                                    <input type="hidden" name="SelectedRegions" value="@value" />
                                }
                            </div>
                        </section>
                    </div>

                    <div class="govuk-accordion__section">
                        <div class="govuk-accordion__section-header">
                            <h2 class="govuk-accordion__section-heading">
                                <span class="govuk-accordion__section-button" id="projects-filter-local-authority-heading">
                                    Local authority
                                </span>
                            </h2>
                        </div>
                        <section class="govuk-accordion__section-content" aria-labelledby="projects-filter-local-authority-heading" id="projects-filter-local-authority-content">
                            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                                @foreach (var option in Model.LocalAuthorityOptions)
                                {
                                    var checkboxId = $"local-authority-{option.Value}";
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input"
                                               id="@checkboxId"
                                               name="SelectedLocalAuthorities"
                                               type="checkbox"
                                               value="@option.Value"
                                               checked="@(selectedLocalAuthorities.Contains(option.Value) ? "checked" : null)" />
                                        <label class="govuk-label govuk-checkboxes__label" for="@checkboxId">@option.Label</label>
                                    </div>
                                }
                                @foreach (var value in selectedLocalAuthorities.Except(Model.LocalAuthorityOptions.Select(o => o.Value), StringComparer.OrdinalIgnoreCase))
                                {
                                    <input type="hidden" name="SelectedLocalAuthorities" value="@value" />
                                }
                            </div>
                        </section>
                    </div>
                </div>

                <govuk-button type="submit" class="govuk-!-margin-top-6">Apply filters</govuk-button>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/src/filter.js" asp-add-nonce></script>
