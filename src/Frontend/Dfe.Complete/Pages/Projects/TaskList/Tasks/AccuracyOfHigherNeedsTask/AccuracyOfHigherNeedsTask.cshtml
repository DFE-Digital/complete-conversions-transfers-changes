@page "/projects/{projectId}/tasks/check_accuracy_of_higher_needs"
@using Dfe.Complete.Utils
@inject Microsoft.Extensions.Configuration.IConfiguration _configuration
@model Dfe.Complete.Pages.Projects.TaskList.Tasks.AccuracyOfHigherNeedsTask.AccuracyOfHigherNeedsTaskModel
@{
    Layout = "_ProjectTaskLayout";
    ViewData["Title"] = Model.TaskIdentifier.ToDisplayDescription();
    var academyOpenersEmail = _configuration["Emails:AcademyOpeners"];
}
@section TaskHeaderHintSection {
    <div class="govuk-hint">
        <p>Check accuracy of high needs places information (only required for special academies, alternative provision (AP) academies, any mainstream schools with SEN units / resourced provision (RP). or Hospital Education).</p>
        <p>The local authority funds high needs places at a local authority maintained school. The Funding and Financial Oversight directorate (FFO) funds high needs places at an academy.</p>
        <p>You must make sure that FFO know the correct number of high needs places to fund.</p>
        <p>If it is incorrect, pupils with special educational needs may not get the right support. You will need to work with the school and FFO after opening to resolve any funding payment issues.</p>
        <p>Ask the local authority and school to confirm if there are high needs places at the school. They also need to tell you if that number is the same or will be different at the academy.</p>
        <p>The information the local authority and school have may differ and they may not agree on numbers.</p>
        <p>If that is the case the FFO will use the latest section 251 spreadsheet to make a funding decision.</p>

        <span>You need to talk to the local authority and school to confirm:</span>
        <ul class="govuk-!-margin-top-0">
            <li>whether the school has high needs places</li> 
            <li>the number of high needs places that FFO must fund at the academy</li>
            <li>how many of those funded places are for pre-16 pupils (up to and including year 11)</li>
            <li>how many of those funded places are post-16 pupils (years 12 and 13)</li> 
        </ul>
    </div>
}
@section TaskSection {
    <form method="post">
        <input type="hidden" asp-for="TasksDataId" />
        <govuk-checkboxes name="@nameof(Model.SelectedOptions)" id-prefix="check-accuracy-options">
            <govuk-checkboxes-fieldset>

                <govuk-checkboxes-fieldset-legend is-page-heading="false" class="govuk-fieldset__legend--m">
                    Check Accuracy of High Needs Places
                    <span class="govuk-caption-m">Select all that apply</span>
                </govuk-checkboxes-fieldset-legend>

                <govuk-checkboxes-item data-cy="@nameof(Model.NotApplicable)" id="@(nameof(Model.NotApplicable))" value="not-applicable" checked="@Model.SelectedOptions.Contains("not-applicable")" behavior="Exclusive">
                    <b>Not applicable</b>
                </govuk-checkboxes-item>

                <govuk-checkboxes-divider>or</govuk-checkboxes-divider>

                <govuk-checkboxes-item data-cy="@nameof(Model.ConfirmPublishedNumber)" id="@(nameof(Model.ConfirmPublishedNumber))" value="confirm-published-number" checked="@Model.SelectedOptions.Contains("confirm-published-number")">
                    <b>Confirm the section 251 spreadsheet shows the correct number of high needs places FFO must fund</b>
                </govuk-checkboxes-item>

                <govuk-checkboxes-item data-cy="@nameof(Model.ConfirmNumber)" id="@(nameof(Model.ConfirmNumber))" value="confirm-number" checked="@Model.SelectedOptions.Contains("confirm-number")">
                    <b>Tell the local authority to complete the Notification of Changes form</b>
                    <div class="govuk-hint">
                        <p>Email the document to your local authority contact. They must complete the notification of change and email it back to you. They must also include the school in the email they send you.</p>
                    </div>
                </govuk-checkboxes-item>

                <govuk-checkboxes-item data-cy="@nameof(Model.CheckReturnedForm)" id="@(nameof(Model.CheckReturnedForm))" value="check-returned-form" checked="@Model.SelectedOptions.Contains("check-returned-form")">
                    <b>Check the returned Notification of Changes form</b>
                    <div class="govuk-hint">
                        <p>Compare the notification of changes document to the section 251 spreadsheet.</p>
                    </div>
                </govuk-checkboxes-item>

                <govuk-checkboxes-item data-cy="@nameof(Model.SendForm)" id="@(nameof(Model.SendForm))" value="send-form" checked="@Model.SelectedOptions.Contains("send-form")">
                    <b>Send the completed Notification of Changes form to FFO</b>
                    <div class="govuk-hint">
                        <p>Email the completed notification of change document to the FFO at <a href="mailto:@academyOpenersEmail">@academyOpenersEmail</a>.</p>
                    </div>
                </govuk-checkboxes-item>
            </govuk-checkboxes-fieldset>
        </govuk-checkboxes>

        @await Html.PartialAsync("_TaskSaveAndReturn", new TaskSaveAndReturnModel(Model.Project, Model.CurrentUserTeam))
    </form>
}
